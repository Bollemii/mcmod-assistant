# Copie ce fichier en server/.env et remplis les valeurs.
# server/.env est ignoré par git : ne mets jamais tes clés dans un autre fichier.
# Une variable déjà définie dans l'environnement l'emporte sur ce fichier.

# --- LLM -----------------------------------------------------------------------------
# Fournisseur : gemini (défaut, gratuit), claude, openai (API compatible OpenAI) ou fake
ASSIST_LLM=gemini

# Gemini : clé créée sur https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Claude (facturé à l'usage, hors abonnement Pro)
# ANTHROPIC_API_KEY=

# API compatible OpenAI, par exemple Ollama en local
# ASSIST_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# ASSIST_OPENAI_API_KEY=

# Modèle (facultatif, sauf avec openai) et profondeur de réflexion (low, medium, high)
# ASSIST_MODEL=gemini-3.8-flash
# ASSIST_EFFORT=low

# --- Limites et fichiers -------------------------------------------------------------
# ASSIST_RATE_LIMIT=10
# ASSIST_RATE_WINDOW_S=60
# ASSIST_TOKENS_FILE=config/tokens.txt
# ASSIST_LOG_FILE=data/logs/queries.jsonl
