# Copie ce fichier en server/.env et remplis les valeurs.
# server/.env est ignoré par git : ne mets jamais tes clés dans un autre fichier.
# Une variable déjà définie dans l'environnement l'emporte sur ce fichier.

# --- LLM -----------------------------------------------------------------------------
# Fournisseur : gemini (défaut, gratuit), claude, openai (API compatible OpenAI) ou fake
ASSIST_LLM=gemini

# Gemini : clé créée sur https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Claude (facturé à l'usage, hors abonnement Pro)
# ANTHROPIC_API_KEY=

# API compatible OpenAI, par exemple Ollama en local
# ASSIST_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# ASSIST_OPENAI_API_KEY=

# Modèle (facultatif, sauf avec openai) et profondeur de réflexion (low, medium, high)
# ASSIST_MODEL=gemini-3.8-flash
# ASSIST_EFFORT=low

# --- Mode allégé : LLM local quand le fournisseur principal est indisponible -----------
# Quota Gemini atteint, panne, réseau : la question part vers Ollama (gemma3:4b, sur
# processeur, ~20 à 30 s), avec un prompt plus court. Le joueur voit « mode allégé ».
# Vide : pas de mode allégé (erreur 503 comme avant). ASSIST_LLM=ollama : tout en local.
# ASSIST_FALLBACK_LLM=ollama
# ASSIST_OLLAMA_MODEL=gemma3:4b
# ASSIST_OLLAMA_URL=http://127.0.0.1:11434
# ASSIST_OLLAMA_THREADS=8
# ASSIST_LIGHT_TOP_K=4
# ASSIST_LIGHT_EXTRACT_CHARS=700

# --- RAG : base et embeddings (phase 2) ------------------------------------------------
# Base lancée par « docker compose up -d ». Vide : réponses sans le wiki (comme en phase 1).
ASSIST_DATABASE_URL=postgresql://assist:assist@127.0.0.1:5433/assist

# Embeddings : ollama (défaut : bge-m3 en local via docker-compose.yml, sans quota),
# gemini (distant, 1 000 textes par jour), openai (autre API compatible) ou fake.
# Changer de modèle : python -m db.load --force
# ASSIST_EMBED=ollama
# ASSIST_EMBED_MODEL=bge-m3
# ASSIST_EMBED_URL=http://127.0.0.1:11434/v1
# Threads de calcul d'Ollama : trop de threads ralentit fortement sous Docker (14 → 3 s par question, 8 → 0,04 s)
# ASSIST_EMBED_THREADS=8
# ASSIST_TOP_K=8

# --- Mise à jour des sources ------------------------------------------------------------
# Rythme par défaut (jours) ; chaque source peut le remplacer (refresh_days dans servers.toml).
# ASSIST_REFRESH_DAYS=7
# Délai minimal entre deux « /assist maj » d'une même source (minutes ; ignoré avec un jeton admin et « force »).
# ASSIST_REFRESH_COOLDOWN_MIN=60
# Fréquence de vérification des sources à mettre à jour (secondes ; 0 = jamais automatiquement).
# ASSIST_REFRESH_CHECK_S=3600

# --- Évaluation (python -m eval.run_eval) -----------------------------------------------
# Prix du LLM en dollars par million de tokens, pour estimer le coût par question (0 = gratuit).
# ASSIST_PRICE_IN=0
# ASSIST_PRICE_OUT=0
# ASSIST_JUDGE_MODEL=gemini-3.5-flash-lite

# --- Limites et fichiers -------------------------------------------------------------
# ASSIST_RATE_LIMIT=10
# ASSIST_RATE_WINDOW_S=60
# ASSIST_TOKENS_FILE=config/tokens.txt
# ASSIST_LOG_FILE=data/logs/queries.jsonl
